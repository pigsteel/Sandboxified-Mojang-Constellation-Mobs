{
  "schemaVersion": 1,
  "id": "smcm",
  "version": "${version}",
  "name": "Sandboxified Mojang Constellation Mobs",
  "description": "Mobs brought over from Mojang's other Minecraft properties, adapted to fit into your favourite sandbox.",
  "authors": ["pigsteel"],
  "contact": {},
  "license": "MIT",
  "icon": "assets/smcm/icon.png",
  "environment": "*",
  "entrypoints": {
    "fabric-datagen": [
      "com.github.pigsteel.smcm.client.SMCMDataGenerator"
    ],
    "client": [
      "com.github.pigsteel.smcm.client.SMCMClient"
    ],
    "main": [
      "com.github.pigsteel.smcm.SMCM"
    ]
  },
  "mixins": [
    "smcm.mixins.json",
    {
      "config": "smcm.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}"
  }
}
